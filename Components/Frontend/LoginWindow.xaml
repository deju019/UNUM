<Window x:Class="UNUM.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNUM - Iniciar Sesión"
    Height="560"
    Width="920"
    MinHeight="520"
    MinWidth="820"
    WindowStartupLocation="CenterScreen"
    Background="#0B1220">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#13203A" Offset="0.5"/>
                <GradientStop Color="#1B2E56" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Margin="26"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="#1FFFFFFF"
                Background="#14FFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="20,0,0,20"
                        Background="#11000000"
                        Padding="38">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UNUM"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Controla tus finanzas sin complicarte."
                                   Margin="0,10,0,0"
                                   Foreground="#DDE8FF"
                                   FontSize="16"
                                   TextWrapping="Wrap"/>

                        <Border Margin="0,28,0,0"
                                CornerRadius="14"
                                Background="#17FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#24FFFFFF"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="• Registro y seguimiento diario"
                                           Foreground="#E8F0FF"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="• Objetivos y presupuestos"
                                           Foreground="#E8F0FF"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="• Análisis mensual claro"
                                           Foreground="#E8F0FF"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        CornerRadius="0,20,20,0"
                        Background="#F8FAFF"
                        Padding="40">
                    <StackPanel VerticalAlignment="Center" MaxWidth="390">
                        <TextBlock Text="Iniciar sesión"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0E1A30"/>
                        <TextBlock Text="Accede para continuar con tu panel."
                                   Margin="0,6,0,22"
                                   FontSize="13"
                                   Foreground="#5A6578"/>

                        <Border x:Name="brdMensajeLogin"
                                Background="#EAF6FF"
                                BorderBrush="#B6DEFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtMensajeLogin"
                                       Foreground="#1E4D6B"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Usuario"
                                   FontWeight="SemiBold"
                                   Foreground="#24324B"/>
                        <TextBox x:Name="txtUsuarioLogin"
                                 Margin="0,7,0,4"
                                 Height="36"
                                 Padding="10,4"
                                 BorderBrush="#CCD6EA"
                                 BorderThickness="1"
                                 Background="White"
                                 TextChanged="txtUsuarioLogin_TextChanged"/>
                        <TextBlock x:Name="txtUsuarioLoginHint"
                                   Margin="0,0,0,12"
                                   Foreground="#B32137"
                                   FontSize="11"
                                   Visibility="Collapsed"/>

                        <TextBlock Text="Contraseña"
                                   FontWeight="SemiBold"
                                   Foreground="#24324B"/>
                        <PasswordBox x:Name="txtPasswordLogin"
                                     Margin="0,7,0,4"
                                     Height="36"
                                     Padding="10,4"
                                     BorderBrush="#CCD6EA"
                                     BorderThickness="1"
                                     Background="White"
                                     PasswordChanged="txtPasswordLogin_PasswordChanged"/>
                        <TextBlock x:Name="txtPasswordLoginHint"
                                   Margin="0,0,0,18"
                                   Foreground="#B32137"
                                   FontSize="11"
                                   Visibility="Collapsed"/>

                        <Button x:Name="btnLogin"
                                Content="Entrar"
                                Height="40"
                                Click="btnLogin_Click"
                                Background="#1C5DFF"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <Button x:Name="btnVolverLogin"
                                Content="Volver al inicio"
                                Height="34"
                                Margin="0,12,0,0"
                                Click="btnVolverLogin_Click"
                                Background="Transparent"
                                Foreground="#1C5DFF"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
