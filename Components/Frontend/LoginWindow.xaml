<Window x:Class="UNUM.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNUM - Iniciar Sesión" Height="470" Width="620" MinHeight="440" MinWidth="580" Background="{DynamicResource MaterialDesignPaper}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Border Background="#FFF7F9FB" CornerRadius="10" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
            <TextBlock Text="Bienvenido a UNUM" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Border x:Name="brdMensajeLogin"
                    Background="#FFEAF6FF"
                    BorderBrush="#FFB6DEFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtMensajeLogin"
                           Foreground="#FF1E4D6B"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="Usuario:"/>
            <TextBox x:Name="txtUsuarioLogin" Margin="0,6,0,4" Height="32" TextChanged="txtUsuarioLogin_TextChanged"/>
            <TextBlock x:Name="txtUsuarioLoginHint"
                       Margin="0,0,0,12"
                       Foreground="#FF8A1F2A"
                       FontSize="11"
                       Visibility="Collapsed"/>

            <TextBlock Text="Contraseña:"/>
            <PasswordBox x:Name="txtPasswordLogin" Margin="0,6,0,4" Height="32" PasswordChanged="txtPasswordLogin_PasswordChanged"/>
            <TextBlock x:Name="txtPasswordLoginHint"
                       Margin="0,0,0,16"
                       Foreground="#FF8A1F2A"
                       FontSize="11"
                       Visibility="Collapsed"/>

            <Button x:Name="btnLogin" Content="Iniciar Sesión" Height="34" Click="btnLogin_Click" Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>

            <Button x:Name="btnVolverLogin"
                    Content="Volver al Inicio"
                    Height="32"
                    Margin="0,12,0,0"
                    Click="btnVolverLogin_Click"
                    Background="Transparent"
                    Foreground="#FF0078D7"
                    BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
