<Window x:Class="UNUM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UNUM.Converters"
        Title="UNUM - Dashboard Financiero"
        Height="860"
    Width="1360"
    MinHeight="800"
    MinWidth="1240"
    Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:DecimalToEuroStringConverter x:Key="DecimalToEuroConverter"/>
        <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
        <local:PercentageToBrushConverter x:Key="PercentageToBrushConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:MenuActiveBackgroundConverter x:Key="MenuActiveBackgroundConverter"/>
        <local:DecimalSaldoToBrushConverter x:Key="DecimalSaldoToBrushConverter"/>
        <local:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter"/>
        <local:InvertedEmptyCollectionToVisibilityConverter x:Key="InvertedEmptyCollectionToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="panelSidebar" Grid.Column="0"
            Background="#13203A">
            <DockPanel LastChildFill="True">
                <Button x:Name="btnCerrarSesion"
                        Content="Cerrar Sesión"
                        Height="35"
                    Background="#D94B64"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                    ToolTip="Cierra la sesión actual y vuelve a la pantalla de inicio"
                        Margin="20,0,20,20"
                        Command="{Binding CerrarSesionCommand}"
                        DockPanel.Dock="Bottom"/>

                <StackPanel Margin="0,30,0,0">
                    <!-- Logo UNUM (Solo imagen grande) -->
                    <Grid Height="140" Width="140" Margin="20,0,20,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Subtle contrast background to improve clarity on dark sidebar -->
                        <Ellipse Fill="#14FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Border CornerRadius="70" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="imgLogo" Width="120" Height="120" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <Image.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.6" />
                                </Image.Effect>
                            </Image>
                        </Border>
                    </Grid>

                <Button x:Name="btnMenuTransacciones"
                        Content="📊 Mis Transacciones"
                        Height="45"
                    Background="{Binding MenuTransaccionesActivo, Converter={StaticResource MenuActiveBackgroundConverter}}"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                    ToolTip="Ir al panel de transacciones y filtros"
                        Margin="0,0,0,10"
                        Command="{Binding MostrarTransaccionesCommand}"/>

                <Button x:Name="btnMenuSimulador"
                        Content="🎯 Mis Objetivos"
                        Height="45"
                    Background="{Binding MenuSimuladorActivo, Converter={StaticResource MenuActiveBackgroundConverter}}"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                    ToolTip="Ir al panel de objetivos de ahorro"
                        Margin="0,0,0,10"
                        Command="{Binding MostrarSimuladorCommand}"/>

                <Button x:Name="btnTutorial"
                        Content="❓ Tutorial"
                        Height="35"
                    Background="#1C5DFF"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        BorderThickness="0"
                        ToolTip="Reabre el tutorial de bienvenida"
                        Margin="0,0,0,40"
                        Click="btnTutorial_Click"/>

                <Border x:Name="borderSaldo"
                        Margin="15,0,15,0"
                    Background="#1C5DFF"
                        CornerRadius="8"
                        Padding="10"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <TextBlock Text="Saldo Actual"
                                   Foreground="White"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   UseLayoutRounding="True"
                                   SnapsToDevicePixels="True"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType" />
                        <TextBlock x:Name="txtSaldoTotal"
                                   Text="{Binding FinancialSummary.Saldo, Converter={StaticResource DecimalToEuroConverter}}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   UseLayoutRounding="True"
                                   SnapsToDevicePixels="True"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType" />
                    </StackPanel>
                </Border>

                                </StackPanel>
                        </DockPanel>
        </Border>

                <ScrollViewer x:Name="mainScrollViewer" Grid.Column="1"
                                            Margin="16"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                        <Grid>

            <Grid x:Name="panelTransacciones"
                Visibility="{Binding IsTransaccionesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="borderRegistroTransaccion" Grid.Row="0"
                    Background="#FFF8FAFF"
                    BorderBrush="#FFD6E0F5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding TransactionFormTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,15"/>

                        <!-- Fila 1: Tipo, Categoría, Importe -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Tipo" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
                                <ComboBox x:Name="cmbTipo"
                                          Height="32"
                                          SelectedItem="{Binding TipoTransaccion, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesTipo}"
                                          ToolTip="Selecciona si quieres registrar un ingreso o un gasto"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Categoría" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
                                <ComboBox x:Name="cmbCategoria"
                                          Height="32"
                                          SelectedItem="{Binding CategoriaTransaccion, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesCategoria}"
                                          ToolTip="Categoría asociada al tipo seleccionado"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Importe (€)" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="txtImporte"
                                         Height="32"
                                         Text="{Binding ImporteTransaccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Importe de la transacción. Ejemplo: 25,50"
                                         Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Fecha" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
                                <DatePicker x:Name="dpFechaTransaccion"
                                            SelectedDate="{Binding FechaTransaccion, Mode=TwoWay}"
                                            Height="32"
                                            ToolTip="Fecha del movimiento"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila 2: Descripción (ancho completo) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Descripción (opcional)" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="txtDescripcion"
                                         Height="32"
                                         Text="{Binding DescripcionTransaccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Descripción para identificar mejor el movimiento"
                                         Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila 3: Información + Botones -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="#FF6C757D"
                                       FontSize="11"
                                       Text="En edición se actualiza la transacción seleccionada"/>

                            <Button x:Name="btnGuardarTransaccion"
                                    Grid.Column="1"
                                    Content="{Binding TransactionSubmitText}"
                                    Height="32"
                                    Padding="16,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding GuardarTransaccionCommand}"
                                    Background="#1C5DFF"
                                    Foreground="White"
                                    ToolTip="Guardar la transacción con los datos introducidos"
                                    FontWeight="Bold"/>

                            <Button x:Name="btnCancelarEdicionTransaccion"
                                    Grid.Column="2"
                                    Content="Cancelar"
                                    Height="32"
                                    Padding="16,0"
                                    Command="{Binding CancelarEdicionTransaccionCommand}"
                                    Visibility="{Binding IsEditingTransaccion, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#5A6578"
                                    Foreground="White"
                                    FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Resumen financiero"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFEAF8EE"
                                CornerRadius="6"
                                Padding="16,18"
                                Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Ingresos"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"
                                           FontSize="11"
                                           Margin="0,0,0,6"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="txtTotalIngresos"
                                           Text="{Binding FinancialSummary.TotalIngresos, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#FFFDECEC"
                                CornerRadius="6"
                                Padding="16,18"
                                Margin="4,0,4,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Gastos"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"
                                           FontSize="11"
                                           Margin="0,0,0,6"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="txtTotalGastos"
                                           Text="{Binding FinancialSummary.TotalGastos, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FFEFF3FF"
                                CornerRadius="6"
                                Padding="16,18"
                                Margin="8,0,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Balance"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"
                                           FontSize="11"
                                           Margin="0,0,0,6"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="txtBalanceNeto"
                                           Text="{Binding FinancialSummary.Saldo, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding FinancialSummary.Saldo, Converter={StaticResource DecimalSaldoToBrushConverter}}"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#FFFDFDFD"
                            BorderBrush="#FFE3E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Analítica del mes"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"/>

                                <Button Grid.Column="1"
                                        Content="Solo este mes"
                                        Height="28"
                                        Padding="12,0"
                                        Command="{Binding SoloMesActualCommand}"
                                        Background="#FF1D4E89"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        ToolTip="Filtra rápidamente la tabla para ver solo el mes actual"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.7*"/>
                                </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Mes actual"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Ingresos"
                                           FontSize="12"
                                           Foreground="#FF5A6270"/>
                                <TextBlock Text="{Binding MonthlyAnalytics.IngresosMes, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="Gastos"
                                           FontSize="12"
                                           Foreground="#FF5A6270"/>
                                <TextBlock Text="{Binding MonthlyAnalytics.GastosMes, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="Balance"
                                           FontSize="12"
                                           Foreground="#FF5A6270"/>
                                <TextBlock Text="{Binding MonthlyAnalytics.BalanceMes, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Proyección fin de mes"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Ingresos proyectados"
                                           FontSize="12"
                                           Foreground="#FF5A6270"/>
                                <TextBlock Text="{Binding MonthlyProjection.IngresosProyectados, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="Gastos proyectados"
                                           FontSize="12"
                                           Foreground="#FF5A6270"/>
                                <TextBlock Text="{Binding MonthlyProjection.GastosProyectados, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="Balance proyectado"
                                           FontSize="12"
                                           Foreground="#FF5A6270"/>
                                <TextBlock Text="{Binding MonthlyProjection.BalanceProyectado, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"/>

                                <TextBlock Text="Mes anterior"
                                           FontSize="12"
                                           Foreground="#FF5A6270"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding MonthlyProjection.BalanceMesAnterior, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FF6C757D"/>

                                <TextBlock Text="Variación vs. mes anterior"
                                           FontSize="12"
                                           Foreground="#FF5A6270"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding MonthlyProjection.VariacionVsMesAnterior, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontWeight="Bold"
                                           Foreground="#FF8A1F2A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Top categorías de gasto (mes)"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding MonthlyProjection.ResumenEscenario}"
                                           FontSize="12"
                                           Foreground="#FF5A6270"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <Border Background="#FFFDECEC"
                                        BorderBrush="#FFF5C2C7"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding MonthlyProjection.AlertaDeficit}"
                                               Foreground="#FF8A1F2A"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding RiskBadges}"
                                              Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BackgroundHex}"
                                                    BorderBrush="{Binding BorderHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="10,6"
                                                    Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nivel}"
                                                               Foreground="{Binding ForegroundHex}"
                                                               FontWeight="Bold"
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Descripcion}"
                                                               Foreground="{Binding ForegroundHex}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="120"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding TopCategoriasGasto}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF7F9FB"
                                                    BorderBrush="#FFE3E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{Binding Categoria}"
                                                               FontWeight="Bold"
                                                               Foreground="#FF2C3E50"/>
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding Resumen}"
                                                               Foreground="#FF5A6270"
                                                               FontSize="12"
                                                               Margin="8,0,0,0"/>
                                                    <ProgressBar Grid.Row="1"
                                                                 Grid.Column="0"
                                                                 Grid.ColumnSpan="2"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding Porcentaje}"
                                                                 Height="8"
                                                                 Margin="0,6,0,0"
                                                                 Foreground="{Binding Porcentaje, Converter={StaticResource PercentageToBrushConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="borderPresupuestos"
                    Grid.Row="2"
                        Background="#FFF8FAFF"
                        BorderBrush="#FFD6E0F5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding PresupuestoFormTitle}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Categoría" FontWeight="Bold" Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbPresupuestoCategoria"
                                          Width="210"
                                          Height="28"
                                          SelectedItem="{Binding PresupuestoCategoriaSeleccionada, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesPresupuestoCategoria}"
                                          ToolTip="Selecciona la categoría de gasto para definir su presupuesto"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Límite mensual (€)" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtPresupuestoLimite"
                                         Width="170"
                                         Height="28"
                                         Text="{Binding PresupuestoLimiteMensual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Importe máximo recomendado para esta categoría"/>
                            </StackPanel>

                            <Button x:Name="btnGuardarPresupuesto"
                                    Grid.Column="2"
                                    Content="{Binding PresupuestoSaveText}"
                                    Padding="12,0"
                                    Height="28"
                                    Margin="0,20,10,0"
                                    Command="{Binding GuardarPresupuestoCommand}"
                                    Background="#1C5DFF"
                                    Foreground="White"
                                    FontWeight="Bold"/>

                            <Button x:Name="btnCancelarEdicionPresupuesto"
                                    Grid.Column="3"
                                    Content="Cancelar"
                                    Padding="12,0"
                                    Height="28"
                                    Margin="0,20,10,0"
                                    Command="{Binding CancelarEdicionPresupuestoCommand}"
                                    Background="#5A6578"
                                    Foreground="White"
                                    FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditingPresupuesto}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="btnReiniciarPresupuestos"
                                    Grid.Column="4"
                                    Content="Reset"
                                    Padding="12,0"
                                    Height="28"
                                    Margin="0,20,0,0"
                                    Command="{Binding ReiniciarPresupuestosCommand}"
                                    Background="#5A6578"
                                    Foreground="White"
                                    FontWeight="Bold"/>
                        </Grid>

                        <ItemsControl x:Name="itemsPresupuestos"
                                      Grid.Row="2"
                                      ItemsSource="{Binding PresupuestosUI}"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="#FFE3E7EB"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding Categoria}"
                                                       FontWeight="Bold"
                                                       Foreground="#FF2C3E50"/>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{Binding Resumen}"
                                                       Foreground="#FF5A6270"
                                                       FontSize="12"
                                                       Margin="8,0,0,0"/>

                                            <Button Grid.Row="0"
                                                    Grid.Column="2"
                                                    Content="Editar"
                                                    Height="24"
                                                    Padding="10,0"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EditarPresupuestoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1C5DFF"
                                                    Foreground="White"
                                                    FontWeight="Bold"/>

                                            <Button Grid.Row="0"
                                                    Grid.Column="3"
                                                    Content="✕"
                                                    Height="24"
                                                    Width="24"
                                                    Padding="0"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EliminarPresupuestoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#FFDC3545"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    ToolTip="Eliminar este presupuesto"/>

                                            <ProgressBar Grid.Row="1"
                                                         Grid.Column="0"
                                                         Grid.ColumnSpan="3"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Porcentaje}"
                                                         Height="10"
                                                         Margin="0,6,0,0"
                                                         Foreground="{Binding Porcentaje, Converter={StaticResource PercentageToBrushConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border x:Name="borderFiltrosBusqueda" Grid.Row="3"
                    Background="#FFF8FAFF"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Filtros de búsqueda"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"/>
                                <TextBlock Text="Solo afectan a la tabla, no al resumen financiero"
                                           FontSize="12"
                                           Foreground="#FF6C757D"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button x:Name="btnAlternarFiltrosAvanzados"
                                    Grid.Column="1"
                                    Content="📋 Avanzados"
                                    Height="30"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding AlternarFiltrosAvanzadosCommand}"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    ToolTip="Mostrar/ocultar filtros avanzados (fechas, importes)"
                                    FontWeight="Bold"/>

                            <Button x:Name="btnRefrescar"
                                    Grid.Column="2"
                                    Content="↻ Actualizar"
                                    Height="30"
                                    Width="120"
                                    Command="{Binding RefrescarCommand}"
                                    Background="#FF17A2B8"
                                    Foreground="White"
                                    ToolTip="Recargar transacciones desde la base de datos"
                                    FontWeight="Bold"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Tipo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbFiltroTipo"
                                          Height="30"
                                          ToolTip="Filtra por tipo de transacción"
                                          SelectedItem="{Binding FiltroTipo, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesFiltroTipo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Categoría" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbFiltroCategoria"
                                          Height="30"
                                          SelectedItem="{Binding FiltroCategoria, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesFiltroCategoria}"
                                          ToolTip="Filtra por categoría"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Periodo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbFiltroPeriodo"
                                          Height="30"
                                          ToolTip="Limita la vista a histórico o al mes actual"
                                          SelectedItem="{Binding FiltroPeriodo, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesFiltroPeriodo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Buscar" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtFiltroTexto"
                                         Text="{Binding FiltroTextoLibre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30"
                                         ToolTip="Busca por descripción, categoría o tipo"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0"
                              Visibility="{Binding FiltrosAvanzadosExpandidos, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Desde" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpFechaDesde"
                                            SelectedDate="{Binding FiltroFechaDesde, Mode=TwoWay}"
                                            Width="190"
                                            Height="30"
                                            ToolTip="Fecha mínima del rango"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Hasta" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpFechaHasta"
                                            SelectedDate="{Binding FiltroFechaHasta, Mode=TwoWay}"
                                            Width="190"
                                            Height="30"
                                            ToolTip="Fecha máxima del rango"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Importe mín." FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtImporteMin"
                                         Text="{Binding FiltroImporteMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="190"
                                         Height="30"
                                         ToolTip="Importe mínimo incluido en el filtro"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Importe máx." FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtImporteMax"
                                         Text="{Binding FiltroImporteMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="190"
                                         Height="30"
                                         ToolTip="Importe máximo incluido en el filtro"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <Button x:Name="btnLimpiarFiltros"
                                    Content="Limpiar"
                                    Height="30"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding LimpiarFiltrosCommand}"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    ToolTip="Quitar filtros y volver a la vista completa"
                                    FontWeight="Bold"/>

                            <Button x:Name="btnAplicarFiltros"
                                    Content="Aplicar filtros"
                                    Height="30"
                                    Padding="12,0"
                                    Command="{Binding AplicarFiltrosCommand}"
                                    Background="#FF2E86C1"
                                    Foreground="White"
                                    ToolTip="Aplicar todos los filtros seleccionados"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="#FFFDFDFD"
                        BorderBrush="#FFE3E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Estado de filtros"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filtros activos"
                                       Grid.Column="0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FF5A6270"/>
                            <TextBlock x:Name="txtResumenResultados"
                                       Grid.Column="1"
                                       Text="{Binding ResumenResultados}"
                                       FontSize="12"
                                       Foreground="#FF6C757D"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl x:Name="panelFiltrosActivos"
                                      ItemsSource="{Binding FiltrosActivosDisplay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFEAF3FF"
                                            BorderBrush="#FFB8D7F6"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,6,6"
                                            Padding="8,3">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   Foreground="#FF1E5A8A"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                    <Grid x:Name="panelHistorialTransacciones" Grid.Row="5"
                      Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Historial de transacciones"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="gridTransacciones"
                                  ItemsSource="{Binding TransaccionesView}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Background="White"
                                  AlternatingRowBackground="#FFF5F8FF"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  AutoGeneratingColumn="gridTransacciones_AutoGeneratingColumn">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#2C2C2C"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#2C2C2C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="Foreground" Value="#2C2C2C"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFEFF4FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFDDE9FF"/>
                                            <Setter Property="BorderBrush" Value="#1C5DFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="#2C2C2C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <Border x:Name="panelEstadoVacioTransacciones"
                            Visibility="{Binding TransaccionesView, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"
                                Background="#CCFFFFFF"
                                BorderBrush="#FFE3E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="12"
                                Padding="20">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="No hay transacciones para mostrar"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Prueba a limpiar filtros o registra una nueva transacción."
                                           Foreground="#FF5A6270"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="panelCargaTransacciones"
                            Visibility="{Binding IsLoadingTransactions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#AAFFFFFF"
                                CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="220"
                                             Height="8"
                                             IsIndeterminate="True"
                                             Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtEstadoCargaTransacciones"
                                           Text="{Binding LoadingMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF2C3E50"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                    <Grid x:Name="panelAccionesRapidas" Grid.Row="6"
                      Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="4"
                               Text="Acciones rápidas"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,8"/>

                    <Button x:Name="btnExportarCsv"
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="Exportar CSV"
                        Height="30"
                        Width="132"
                        Margin="0,0,8,0"
                        Command="{Binding ExportarCsvCommand}"
                        Background="#FF198754"
                        Foreground="White"
                        ToolTip="Exportar las transacciones visibles a un archivo CSV"
                        FontWeight="Bold"/>

                    <Button x:Name="btnBorrarTransaccion"
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="Eliminar Seleccionada"
                        Height="30"
                        Padding="12,0"
                        Margin="0,0,12,0"
                        Command="{Binding BorrarTransaccionCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=gridTransacciones}"
                        Background="#FFDC3545"
                        Foreground="White"
                        ToolTip="Eliminar la fila seleccionada en la tabla de transacciones"
                        FontWeight="Bold"/>

                    <Button x:Name="btnEditarTransaccion"
                        Grid.Row="1"
                        Grid.Column="3"
                        Content="Editar Seleccionada"
                        Height="30"
                        Padding="12,0"
                        Margin="0,0,0,0"
                        Command="{Binding EditarTransaccionCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=gridTransacciones}"
                        Background="#1C5DFF"
                        Foreground="White"
                        ToolTip="Cargar la fila seleccionada en el formulario para editarla"
                        FontWeight="Bold"/>
                </Grid>
                </Grid>

                <Grid x:Name="panelSimulador"
                    Visibility="{Binding IsSimuladorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                    Background="#FFEAF1FF"
                    BorderBrush="#1C5DFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="📌 ¿Qué son los objetivos?"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1C5DFF"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Crea metas de ahorro personales. Establece cuánto quieres ahorrar, cúanto has ahorrado ya y su prioridad. Ve el progreso en tiempo real."
                                   FontSize="12"
                                   Foreground="#FF2C3E50"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="💡 Consejo: Puedes editar los objetivos en cualquier momento para actualizar el progreso."
                                   FontSize="11"
                                   Foreground="#FF5A6270"
                                   TextWrapping="Wrap"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">
                    <Button x:Name="btnNuevoObjetivo"
                            Content="➕ Nuevo Objetivo"
                            Height="38"
                            Padding="14,0"
                        Command="{Binding NuevoObjetivoCommand}"
                            Background="#1C5DFF"
                            Foreground="White"
                            ToolTip="Crear un nuevo objetivo de ahorro"
                            FontWeight="Bold"
                            Margin="0,0,10,0"
                            FontSize="13"/>
                    <Button x:Name="btnEditarObjetivo"
                            Content="✏️ Editar"
                            Height="38"
                            Padding="14,0"
                        Command="{Binding EditarObjetivoCommand}"
                            Background="#1C5DFF"
                            Foreground="White"
                            ToolTip="Editar el objetivo seleccionado"
                            FontWeight="Bold"
                            Margin="0,0,10,0"
                            FontSize="13"/>
                    <Button x:Name="btnBorrarObjetivo"
                            Content="🗑️ Eliminar"
                            Height="38"
                            Padding="14,0"
                        Command="{Binding BorrarObjetivoCommand}"
                            Background="#FFDC3545"
                            Foreground="White"
                            ToolTip="Eliminar el objetivo seleccionado"
                            FontWeight="Bold"
                            FontSize="13"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="gridObjetivos"
                        ItemsSource="{Binding Objetivos}"
                        SelectedItem="{Binding ObjetivoSeleccionado, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        Background="White"
                        AlternatingRowBackground="#FFF9F9F9"
                        SelectionMode="Single"
                        Visibility="{Binding TieneObjetivos, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Prioridad"
                            Binding="{Binding PrioridadTexto}"
                            Width="80"/>
                        <DataGridTextColumn Header="Meta"
                            Binding="{Binding Nombre}"
                            Width="*"/>
                        <DataGridTextColumn Header="Ahorrado"
                            Binding="{Binding AhorroActual, StringFormat={}{0:0.00} €}"
                            Width="90"/>
                        <DataGridTextColumn Header="Coste"
                            Binding="{Binding CosteTotal, StringFormat={}{0:0.00} €}"
                            Width="90"/>

                        <DataGridTemplateColumn Header="Progreso"
                            Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                            <ProgressBar Minimum="0"
                                Maximum="{Binding CosteTotal}"
                                Value="{Binding AhorroActual}"
                                Height="15"
                                Margin="5,0"
                                Foreground="#28A745"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="%"
                            Binding="{Binding Porcentaje, StringFormat={}{0:0.0}%}"
                            Width="60"/>
                        <DataGridTextColumn Header="Id"
                            Binding="{Binding Id}"
                            Visibility="Hidden"/>
                    </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="panelEstadoVacioObjetivos"
                        Visibility="{Binding TieneObjetivos, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                        Background="#CCFFFFFF"
                        BorderBrush="#FFE3E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12"
                        Padding="20">
                    <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="Todavía no tienes objetivos"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                        <TextBlock Text="Pulsa en 'Nuevo Objetivo' para empezar a planificar tu ahorro."
                               Foreground="#FF5A6270"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
