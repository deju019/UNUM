<Window x:Class="UNUM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUM - Panel de Control"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,20">
            <TextBlock x:Name="txtBienvenida"
                       Text="Cargando panel..."
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button x:Name="btnObjetivos"
                Content="Objetivos"
                Width="100"
                Height="30"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                Click="btnObjetivos_Click"
                Background="#FF6C757D"
                Foreground="White"
                FontWeight="Bold"
                DockPanel.Dock="Right"/>
            <Button x:Name="btnCerrarSesion"
                    Content="Cerrar Sesión"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="btnCerrarSesion_Click"
                    Background="#FFDC3545"
                    Foreground="White"
                    FontWeight="Bold"
                    DockPanel.Dock="Right"/>
        </DockPanel>

        <Border Grid.Row="1"
                Background="#FFF0F0F0"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tipo"
                           Grid.Column="0"
                           FontWeight="Bold"/>
                <ComboBox x:Name="cmbTipo"
                          Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,5,10,0"
                          Height="25">
                    <ComboBoxItem Content="Gasto"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="Ingreso"/>
                </ComboBox>

                <TextBlock Text="Categoría"
                           Grid.Column="1"
                           FontWeight="Bold"/>
                <ComboBox x:Name="cmbCategoria"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,5,10,0"
                          Height="25">
                    <ComboBoxItem Content="Ocio"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="Nómina"/>
                    <ComboBoxItem Content="Supermercado"/>
                    <ComboBoxItem Content="Facturas"/>
                    <ComboBoxItem Content="Otros"/>
                </ComboBox>

                <TextBlock Text="Importe (€)"
                           Grid.Column="2"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtImporte"
                         Grid.Row="1"
                         Grid.Column="2"
                         Margin="0,5,10,0"
                         Height="25"/>

                <TextBlock Text="Descripción"
                           Grid.Column="3"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtDescripcion"
                         Grid.Row="1"
                         Grid.Column="3"
                         Margin="0,5,10,0"
                         Height="25"/>

                <Button x:Name="btnGuardarTransaccion"
                        Content="Añadir"
                        Grid.Row="1"
                        Grid.Column="4"
                        Width="80"
                        Height="25"
                        Margin="0,5,0,0"
                        Click="btnGuardarTransaccion_Click"
                        Background="#FF28A745"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="gridTransacciones"
                    Grid.Row="0"
                    AutoGenerateColumns="True"
                    IsReadOnly="True"
                    Background="White"
                    AlternatingRowBackground="#FFF9F9F9"
                    SelectionMode="Single"/>

            <Grid Grid.Row="1"
                    Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnRefrescar"
                        Grid.Column="0"
                        Content="🔄 Actualizar Tabla"
                        Height="30"
                        Width="150"
                        Click="btnRefrescar_Click"
                        Background="#FF17A2B8"
                        Foreground="White"
                        FontWeight="Bold"/>

                <Button x:Name="btnBorrarTransaccion"
                        Grid.Column="2"
                        Content="Eliminar Transacción"
                        Height="30"
                        Width="200"
                        Click="btnBorrarTransaccion_Click"
                        Background="#FFDC3545"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
