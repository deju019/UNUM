<Window x:Class="UNUM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUM - Dashboard Financiero"
        Height="860"
    Width="1360"
    MinHeight="800"
    MinWidth="1240"
    Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2C3E50">
            <DockPanel LastChildFill="True">
                <Button x:Name="btnCerrarSesion"
                        Content="Cerrar Sesión"
                        Height="35"
                        Background="#E74C3C"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="20,0,20,20"
                        Click="btnCerrarSesion_Click"
                        DockPanel.Dock="Bottom"/>

                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="UNUM"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>

                <Button x:Name="btnMenuTransacciones"
                        Content="📊 Mis Transacciones"
                        Height="45"
                        Background="#34495E"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,10"
                        Click="btnMenuTransacciones_Click"/>

                <Button x:Name="btnMenuSimulador"
                        Content="🎯 Mis Objetivos"
                        Height="45"
                        Background="Transparent"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,40"
                        Click="btnMenuSimulador_Click"/>

                <Border x:Name="borderSaldo"
                        Margin="15,0,15,0"
                        Background="#27AE60"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="Saldo Actual"
                                   Foreground="White"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtSaldoTotal"
                                   Text="0.00 €"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                                </StackPanel>
                        </DockPanel>
        </Border>

                <ScrollViewer Grid.Column="1"
                                            Margin="16"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                        <Grid>

            <Grid x:Name="panelTransacciones"
                  Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFF0F0F0"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Registro de transacciones"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,10"/>

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tipo"
                                   Grid.Column="0"
                                   FontWeight="Bold"/>
                        <ComboBox x:Name="cmbTipo"
                                  Grid.Column="0"
                                  Margin="0,20,10,0"
                                  Height="25"
                                  SelectionChanged="cmbTipo_SelectionChanged">
                            <ComboBoxItem Content="Gasto"
                                          IsSelected="True"/>
                            <ComboBoxItem Content="Ingreso"/>
                        </ComboBox>

                        <TextBlock Text="Categoría"
                                   Grid.Column="1"
                                   FontWeight="Bold"/>
                        <ComboBox x:Name="cmbCategoria"
                                  Grid.Column="1"
                                  Margin="0,20,10,0"
                                  Height="25"/>

                        <TextBlock Text="Importe (€)"
                                   Grid.Column="2"
                                   FontWeight="Bold"/>
                        <TextBox x:Name="txtImporte"
                                 Grid.Column="2"
                                 Margin="0,20,10,0"
                                 Height="25"/>

                        <TextBlock Text="Descripción"
                                   Grid.Column="3"
                                   FontWeight="Bold"/>
                        <TextBox x:Name="txtDescripcion"
                                 Grid.Column="3"
                                 Margin="0,20,10,0"
                                 Height="25"/>

                        <Button x:Name="btnGuardarTransaccion"
                                Content="Añadir"
                                Grid.Column="4"
                                Width="80"
                                Height="25"
                                Margin="0,20,0,0"
                                Click="btnGuardarTransaccion_Click"
                                Background="#FF28A745"
                                Foreground="White"
                                FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Resumen financiero"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFEAF8EE"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Ingresos"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"/>
                                <TextBlock x:Name="txtTotalIngresos"
                                           Text="0.00 €"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#FFFDECEC"
                                CornerRadius="6"
                                Padding="10"
                                Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Gastos"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"/>
                                <TextBlock x:Name="txtTotalGastos"
                                           Text="0.00 €"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FFEFF3FF"
                                CornerRadius="6"
                                Padding="10"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Balance"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"/>
                                <TextBlock x:Name="txtBalanceNeto"
                                           Text="0.00 €"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <Border Grid.Row="3"
                        Background="#FFF7F9FB"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Filtros de búsqueda"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Tipo"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbFiltroTipo"
                                          Width="250"
                                          Height="28"
                                          SelectedIndex="0"
                                          SelectionChanged="cmbFiltroTipo_SelectionChanged">
                                    <ComboBoxItem Content="Todos"/>
                                    <ComboBoxItem Content="Ingreso"/>
                                    <ComboBoxItem Content="Gasto"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Categoría"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbFiltroCategoria"
                                          Width="250"
                                          Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="Periodo"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbFiltroPeriodo"
                                          Width="250"
                                          Height="28"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Historico"/>
                                    <ComboBoxItem Content="Mes actual"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Desde"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <DatePicker x:Name="dpFechaDesde"
                                            Width="250"
                                            Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Hasta"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <DatePicker x:Name="dpFechaHasta"
                                            Width="250"
                                            Height="28"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Min €"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="txtImporteMin"
                                         Width="250"
                                         Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Max €"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="txtImporteMax"
                                         Width="250"
                                         Height="28"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Left">
                            <TextBlock Text="Buscar"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2"/>
                            <TextBox x:Name="txtFiltroTexto"
                                 Width="250"
                                 Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0">
                            <Button x:Name="btnAplicarFiltros"
                                Content="Aplicar"
                                Height="28"
                                Width="88"
                                Margin="0,0,8,0"
                                Click="btnAplicarFiltros_Click"
                                Background="#FF2E86C1"
                                Foreground="White"
                                FontWeight="Bold"/>

                            <Button x:Name="btnLimpiarFiltros"
                                Content="Limpiar"
                                Height="28"
                                Width="88"
                                Margin="0,0,8,0"
                                Click="btnLimpiarFiltros_Click"
                                Background="#FF6C757D"
                                Foreground="White"
                                FontWeight="Bold"/>

                            <Button x:Name="btnRefrescar"
                                Content="🔄 Actualizar Tabla"
                                Height="28"
                                Width="150"
                                Click="btnRefrescar_Click"
                                Background="#FF17A2B8"
                                Foreground="White"
                                FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="#FFFDFDFD"
                        BorderBrush="#FFE3E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Estado de filtros"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filtros activos"
                                       Grid.Column="0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FF5A6270"/>
                            <TextBlock x:Name="txtResumenResultados"
                                       Grid.Column="1"
                                       Text="0 de 0 transacciones"
                                       FontSize="12"
                                       Foreground="#FF6C757D"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <WrapPanel x:Name="panelFiltrosActivos"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="5"
                      Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Historial de transacciones"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="gridTransacciones"
                              Grid.Row="1"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              Background="White"
                              AlternatingRowBackground="#FFF9F9F9"
                              SelectionMode="Single"/>
                </Grid>

                <Grid Grid.Row="6"
                      Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Text="Acciones rápidas"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,8"/>

                    <Button x:Name="btnExportarCsv"
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="Exportar CSV"
                        Height="30"
                        Width="132"
                        Margin="0,0,8,0"
                        Click="btnExportarCsv_Click"
                        Background="#FF198754"
                        Foreground="White"
                        FontWeight="Bold"/>

                    <Button x:Name="btnBorrarTransaccion"
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="Eliminar Seleccionada"
                        Height="30"
                        Width="160"
                        Click="btnBorrarTransaccion_Click"
                        Background="#FFDC3545"
                        Foreground="White"
                        FontWeight="Bold"/>
                </Grid>
                </Grid>

            <Grid x:Name="panelSimulador"
                    Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,15">
                    <Button x:Name="btnNuevoObjetivo"
                            Content="➕ Nuevo Objetivo"
                            Width="150"
                            Height="35"
                            Click="btnNuevoObjetivo_Click"
                            Background="#FF6F42C1"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnBorrarObjetivo"
                            Content="🗑️ Borrar Seleccionado"
                            Width="170"
                            Height="35"
                            Click="btnBorrarObjetivo_Click"
                            Background="#FFDC3545"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>

                <DataGrid x:Name="gridObjetivos"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        Background="White"
                        AlternatingRowBackground="#FFF9F9F9"
                        SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Prioridad"
                                Binding="{Binding PrioridadTexto}"
                                Width="80"/>
                        <DataGridTextColumn Header="Meta"
                                Binding="{Binding Nombre}"
                                Width="*"/>
                        <DataGridTextColumn Header="Ahorrado"
                                Binding="{Binding AhorroActual, StringFormat={}{0:0.00} €}"
                                Width="90"/>
                        <DataGridTextColumn Header="Coste"
                                Binding="{Binding CosteTotal, StringFormat={}{0:0.00} €}"
                                Width="90"/>

                        <DataGridTemplateColumn Header="Progreso"
                                Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Minimum="0"
                                            Maximum="{Binding CosteTotal}"
                                            Value="{Binding AhorroActual}"
                                            Height="15"
                                            Margin="5,0"
                                            Foreground="#28A745"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="%"
                                Binding="{Binding Porcentaje, StringFormat={}{0:0.0}%}"
                                Width="60"/>
                        <DataGridTextColumn Header="Id"
                                Binding="{Binding Id}"
                                Visibility="Hidden"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
