<Window x:Class="UNUM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UNUM.Converters"
        Title="UNUM - Dashboard Financiero"
        Height="860"
    Width="1360"
    MinHeight="800"
    MinWidth="1240"
    Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:DecimalToEuroStringConverter x:Key="DecimalToEuroConverter"/>
        <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
        <local:PercentageToBrushConverter x:Key="PercentageToBrushConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:MenuActiveBackgroundConverter x:Key="MenuActiveBackgroundConverter"/>
        <local:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="panelSidebar" Grid.Column="0"
                Background="#2C3E50">
            <DockPanel LastChildFill="True">
                <Button x:Name="btnCerrarSesion"
                        Content="Cerrar Sesión"
                        Height="35"
                        Background="#E74C3C"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                    ToolTip="Cierra la sesión actual y vuelve a la pantalla de inicio"
                        Margin="20,0,20,20"
                        Command="{Binding CerrarSesionCommand}"
                        DockPanel.Dock="Bottom"/>

                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="UNUM"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>

                <Button x:Name="btnMenuTransacciones"
                        Content="📊 Mis Transacciones"
                        Height="45"
                    Background="{Binding MenuTransaccionesActivo, Converter={StaticResource MenuActiveBackgroundConverter}}"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                    ToolTip="Ir al panel de transacciones y filtros"
                        Margin="0,0,0,10"
                        Command="{Binding MostrarTransaccionesCommand}"/>

                <Button x:Name="btnMenuSimulador"
                        Content="🎯 Mis Objetivos"
                        Height="45"
                    Background="{Binding MenuSimuladorActivo, Converter={StaticResource MenuActiveBackgroundConverter}}"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                    ToolTip="Ir al panel de objetivos de ahorro"
                        Margin="0,0,0,40"
                        Command="{Binding MostrarSimuladorCommand}"/>

                <Border x:Name="borderSaldo"
                        Margin="15,0,15,0"
                        Background="#27AE60"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="Saldo Actual"
                                   Foreground="White"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtSaldoTotal"
                                   Text="{Binding FinancialSummary.Saldo, Converter={StaticResource DecimalToEuroConverter}}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                                </StackPanel>
                        </DockPanel>
        </Border>

                <ScrollViewer x:Name="mainScrollViewer" Grid.Column="1"
                                            Margin="16"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                        <Grid>

            <Grid x:Name="panelTransacciones"
                Visibility="{Binding IsTransaccionesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="borderRegistroTransaccion" Grid.Row="0"
                        Background="#FFF0F0F0"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Registro de transacciones"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,10"/>

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tipo"
                                   Grid.Column="0"
                                   FontWeight="Bold"/>
                        <ComboBox x:Name="cmbTipo"
                                  Grid.Column="0"
                                  Margin="0,20,10,0"
                                  Height="25"
                                  SelectedItem="{Binding TipoTransaccion, Mode=TwoWay}"
                                  ItemsSource="{Binding OpcionesTipo}"
                                  ToolTip="Selecciona si quieres registrar un ingreso o un gasto"/>

                        <TextBlock Text="Categoría"
                                   Grid.Column="1"
                                   FontWeight="Bold"/>
                        <ComboBox x:Name="cmbCategoria"
                                  Grid.Column="1"
                                  Margin="0,20,10,0"
                                  SelectedItem="{Binding CategoriaTransaccion, Mode=TwoWay}"
                                  ItemsSource="{Binding OpcionesCategoria}"
                                  ToolTip="Categoría asociada al tipo seleccionado"
                                  Height="25"/>

                        <TextBlock Text="Importe (€)"
                                   Grid.Column="2"
                                   FontWeight="Bold"/>
                        <TextBox x:Name="txtImporte"
                                 Grid.Column="2"
                                 Margin="0,20,10,0"
                                 Text="{Binding ImporteTransaccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Importe de la transacción. Ejemplo: 25,50"
                                 Height="25"/>

                        <TextBlock Text="Descripción"
                                   Grid.Column="3"
                                   FontWeight="Bold"/>
                        <TextBox x:Name="txtDescripcion"
                                 Grid.Column="3"
                                 Margin="0,20,10,0"
                                 Text="{Binding DescripcionTransaccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Descripción opcional para identificar mejor el movimiento"
                                 Height="25"/>

                        <Button x:Name="btnGuardarTransaccion"
                                Content="Añadir"
                                Grid.Column="4"
                                Width="80"
                                Height="25"
                                Margin="0,20,0,0"
                                Command="{Binding GuardarTransaccionCommand}"
                                Background="#FF28A745"
                                Foreground="White"
                            ToolTip="Guardar la transacción con los datos introducidos"
                                FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Resumen financiero"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFEAF8EE"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Ingresos"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"/>
                                <TextBlock x:Name="txtTotalIngresos"
                                           Text="{Binding FinancialSummary.TotalIngresos, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FF1E7E34"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#FFFDECEC"
                                CornerRadius="6"
                                Padding="10"
                                Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Gastos"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"/>
                                <TextBlock x:Name="txtTotalGastos"
                                           Text="{Binding FinancialSummary.TotalGastos, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FFC0392B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#FFEFF3FF"
                                CornerRadius="6"
                                Padding="10"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Balance"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"/>
                                <TextBlock x:Name="txtBalanceNeto"
                                           Text="{Binding FinancialSummary.Saldo, Converter={StaticResource DecimalToEuroConverter}}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FF1D4E89"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Background="#FFF8FBF7"
                        BorderBrush="#FFDDE8D8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Presupuestos mensuales por categoría"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Categoría" FontWeight="Bold" Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbPresupuestoCategoria"
                                          Width="210"
                                          Height="28"
                                          SelectedItem="{Binding PresupuestoCategoriaSeleccionada, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesPresupuestoCategoria}"
                                          ToolTip="Selecciona la categoría de gasto para definir su presupuesto"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Límite mensual (€)" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtPresupuestoLimite"
                                         Width="170"
                                         Height="28"
                                         Text="{Binding PresupuestoLimiteMensual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Importe máximo recomendado para esta categoría"/>
                            </StackPanel>

                            <Button x:Name="btnGuardarPresupuesto"
                                    Grid.Column="2"
                                    Content="Guardar"
                                    Width="90"
                                    Height="28"
                                    Margin="0,20,10,0"
                                    Command="{Binding GuardarPresupuestoCommand}"
                                    Background="#FF2E86C1"
                                    Foreground="White"
                                    FontWeight="Bold"/>

                            <Button x:Name="btnReiniciarPresupuestos"
                                    Grid.Column="3"
                                    Content="Reset"
                                    Width="80"
                                    Height="28"
                                    Margin="0,20,0,0"
                                    Command="{Binding ReiniciarPresupuestosCommand}"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    FontWeight="Bold"/>
                        </Grid>

                        <ItemsControl x:Name="itemsPresupuestos"
                                      Grid.Row="2"
                                      ItemsSource="{Binding PresupuestosUI}"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="#FFE3E7EB"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding Categoria}"
                                                       FontWeight="Bold"
                                                       Foreground="#FF2C3E50"/>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{Binding Resumen}"
                                                       Foreground="#FF5A6270"
                                                       FontSize="12"
                                                       Margin="8,0,0,0"/>

                                            <ProgressBar Grid.Row="1"
                                                         Grid.Column="0"
                                                         Grid.ColumnSpan="2"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Porcentaje}"
                                                         Height="10"
                                                         Margin="0,6,0,0"
                                                         Foreground="{Binding Porcentaje, Converter={StaticResource PercentageToBrushConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border x:Name="borderFiltrosBusqueda" Grid.Row="3"
                        Background="#FFF7F9FB"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Filtros de búsqueda"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"/>
                                <TextBlock Text="Solo afectan a la tabla, no al resumen financiero"
                                           FontSize="12"
                                           Foreground="#FF6C757D"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button x:Name="btnRefrescar"
                                    Grid.Column="1"
                                    Content="↻ Actualizar"
                                    Height="30"
                                    Width="120"
                                    Command="{Binding RefrescarCommand}"
                                    Background="#FF17A2B8"
                                    Foreground="White"
                                    ToolTip="Recargar transacciones desde la base de datos"
                                    FontWeight="Bold"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Tipo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbFiltroTipo"
                                          Height="30"
                                          ToolTip="Filtra por tipo de transacción"
                                          SelectedItem="{Binding FiltroTipo, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesFiltroTipo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Categoría" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbFiltroCategoria"
                                          Height="30"
                                          SelectedItem="{Binding FiltroCategoria, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesFiltroCategoria}"
                                          ToolTip="Filtra por categoría"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Periodo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbFiltroPeriodo"
                                          Height="30"
                                          ToolTip="Limita la vista a histórico o al mes actual"
                                          SelectedItem="{Binding FiltroPeriodo, Mode=TwoWay}"
                                          ItemsSource="{Binding OpcionesFiltroPeriodo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Buscar" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtFiltroTexto"
                                         Text="{Binding FiltroTextoLibre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30"
                                         ToolTip="Busca por descripción, categoría o tipo"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Desde" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpFechaDesde"
                                            SelectedDate="{Binding FiltroFechaDesde, Mode=TwoWay}"
                                            Width="190"
                                            Height="30"
                                            ToolTip="Fecha mínima del rango"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Hasta" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpFechaHasta"
                                            SelectedDate="{Binding FiltroFechaHasta, Mode=TwoWay}"
                                            Width="190"
                                            Height="30"
                                            ToolTip="Fecha máxima del rango"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Importe mín." FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtImporteMin"
                                         Text="{Binding FiltroImporteMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="190"
                                         Height="30"
                                         ToolTip="Importe mínimo incluido en el filtro"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Importe máx." FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtImporteMax"
                                         Text="{Binding FiltroImporteMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="190"
                                         Height="30"
                                         ToolTip="Importe máximo incluido en el filtro"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0">
                            <Button x:Name="btnLimpiarFiltros"
                                    Content="Limpiar"
                                    Height="30"
                                    Width="100"
                                    Margin="0,0,8,0"
                                    Command="{Binding LimpiarFiltrosCommand}"
                                    Background="#FF6C757D"
                                    Foreground="White"
                                    ToolTip="Quitar filtros y volver a la vista completa"
                                    FontWeight="Bold"/>

                            <Button x:Name="btnAplicarFiltros"
                                    Content="Aplicar filtros"
                                    Height="30"
                                    Width="130"
                                    Command="{Binding AplicarFiltrosCommand}"
                                    Background="#FF2E86C1"
                                    Foreground="White"
                                    ToolTip="Aplicar todos los filtros seleccionados"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="#FFFDFDFD"
                        BorderBrush="#FFE3E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Estado de filtros"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF2C3E50"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filtros activos"
                                       Grid.Column="0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FF5A6270"/>
                            <TextBlock x:Name="txtResumenResultados"
                                       Grid.Column="1"
                                       Text="{Binding ResumenResultados}"
                                       FontSize="12"
                                       Foreground="#FF6C757D"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl x:Name="panelFiltrosActivos"
                                      ItemsSource="{Binding FiltrosActivosDisplay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFEAF3FF"
                                            BorderBrush="#FFB8D7F6"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,6,6"
                                            Padding="8,3">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   Foreground="#FF1E5A8A"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                    <Grid x:Name="panelHistorialTransacciones" Grid.Row="5"
                      Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Historial de transacciones"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="gridTransacciones"
                                  ItemsSource="{Binding TransaccionesView}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Background="White"
                                  AlternatingRowBackground="#FFF9F9F9"
                                  SelectionMode="Single"/>

                        <Border x:Name="panelEstadoVacioTransacciones"
                            Visibility="{Binding TransaccionesView, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"
                                Background="#CCFFFFFF"
                                BorderBrush="#FFE3E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="12"
                                Padding="20">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="No hay transacciones para mostrar"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FF2C3E50"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Prueba a limpiar filtros o registra una nueva transacción."
                                           Foreground="#FF5A6270"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="panelCargaTransacciones"
                            Visibility="{Binding IsLoadingTransactions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#AAFFFFFF"
                                CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="220"
                                             Height="8"
                                             IsIndeterminate="True"
                                             Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtEstadoCargaTransacciones"
                                           Text="{Binding LoadingMessage}"
                                           FontWeight="SemiBold"
                                           Foreground="#FF2C3E50"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                    <Grid x:Name="panelAccionesRapidas" Grid.Row="6"
                      Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Text="Acciones rápidas"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               Margin="0,0,0,8"/>

                    <Button x:Name="btnExportarCsv"
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="Exportar CSV"
                        Height="30"
                        Width="132"
                        Margin="0,0,8,0"
                        Command="{Binding ExportarCsvCommand}"
                        Background="#FF198754"
                        Foreground="White"
                        ToolTip="Exportar las transacciones visibles a un archivo CSV"
                        FontWeight="Bold"/>

                    <Button x:Name="btnBorrarTransaccion"
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="Eliminar Seleccionada"
                        Height="30"
                        Width="160"
                        Command="{Binding BorrarTransaccionCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=gridTransacciones}"
                        Background="#FFDC3545"
                        Foreground="White"
                        ToolTip="Eliminar la fila seleccionada en la tabla de transacciones"
                        FontWeight="Bold"/>
                </Grid>
                </Grid>

                <Grid x:Name="panelSimulador"
                    Visibility="{Binding IsSimuladorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,15">
                    <Button x:Name="btnNuevoObjetivo"
                            Content="➕ Nuevo Objetivo"
                            Width="150"
                            Height="35"
                        Command="{Binding NuevoObjetivoCommand}"
                            Background="#FF6F42C1"
                            Foreground="White"
                            ToolTip="Crear un nuevo objetivo de ahorro"
                            FontWeight="Bold"
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnBorrarObjetivo"
                            Content="🗑️ Borrar Seleccionado"
                            Width="170"
                            Height="35"
                        Command="{Binding BorrarObjetivoCommand}"
                            Background="#FFDC3545"
                            Foreground="White"
                            ToolTip="Eliminar el objetivo seleccionado"
                            FontWeight="Bold"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="gridObjetivos"
                        ItemsSource="{Binding Objetivos}"
                        SelectedItem="{Binding ObjetivoSeleccionado, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        Background="White"
                        AlternatingRowBackground="#FFF9F9F9"
                        SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Prioridad"
                            Binding="{Binding PrioridadTexto}"
                            Width="80"/>
                        <DataGridTextColumn Header="Meta"
                            Binding="{Binding Nombre}"
                            Width="*"/>
                        <DataGridTextColumn Header="Ahorrado"
                            Binding="{Binding AhorroActual, StringFormat={}{0:0.00} €}"
                            Width="90"/>
                        <DataGridTextColumn Header="Coste"
                            Binding="{Binding CosteTotal, StringFormat={}{0:0.00} €}"
                            Width="90"/>

                        <DataGridTemplateColumn Header="Progreso"
                            Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                            <ProgressBar Minimum="0"
                                Maximum="{Binding CosteTotal}"
                                Value="{Binding AhorroActual}"
                                Height="15"
                                Margin="5,0"
                                Foreground="#28A745"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="%"
                            Binding="{Binding Porcentaje, StringFormat={}{0:0.0}%}"
                            Width="60"/>
                        <DataGridTextColumn Header="Id"
                            Binding="{Binding Id}"
                            Visibility="Hidden"/>
                    </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="panelEstadoVacioObjetivos"
                        Visibility="{Binding Objetivos, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"
                        Background="#CCFFFFFF"
                        BorderBrush="#FFE3E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12"
                        Padding="20">
                    <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="Todavía no tienes objetivos"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF2C3E50"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                        <TextBlock Text="Pulsa en 'Nuevo Objetivo' para empezar a planificar tu ahorro."
                               Foreground="#FF5A6270"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
