<Window x:Class="UNUM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUM - Panel de Control" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtBienvenida" Text="Cargando panel..." FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="btnCerrarSesion" Content="Cerrar Sesión" Width="100" Height="30" HorizontalAlignment="Right" Click="btnCerrarSesion_Click" Background="#FFDC3545" Foreground="White" FontWeight="Bold" DockPanel.Dock="Right"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFF0F0F0" CornerRadius="5" Padding="20">
            <TextBlock Text="Aquí irá el formulario para añadir gastos y la tabla con el historial." FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>