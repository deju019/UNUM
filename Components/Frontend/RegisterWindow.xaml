<Window x:Class="UNUM.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUM - Crear Cuenta" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Crear nueva cuenta" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Usuario:"/>
            <TextBox x:Name="txtUsuarioRegistro" Margin="0,5,0,15" Height="25"/>
            
            <TextBlock Text="Contrasena:"/>
            <PasswordBox x:Name="txtPasswordRegistro" Margin="0,5,0,20" Height="25"/>
            
            <Button x:Name="btnRegistrar" Content="Registrarse" Height="30" Click="btnRegistrar_Click" Background="#FF28A745" Foreground="White" FontWeight="Bold"/>
            
            <Button x:Name="btnVolver" Content="Volver al Inicio" Height="30" Margin="0,10,0,0" Click="btnVolver_Click" Background="Transparent" Foreground="#FF0078D7" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>