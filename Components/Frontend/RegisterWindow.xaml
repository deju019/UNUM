<Window x:Class="UNUM.RegisterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UNUM - Crear Cuenta"
    Height="620"
    Width="940"
    MinHeight="560"
    MinWidth="860"
    WindowStartupLocation="CenterScreen"
    Background="#0B1220">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A1222" Offset="0"/>
                <GradientStop Color="#12213F" Offset="0.5"/>
                <GradientStop Color="#193160" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Margin="26"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="#1FFFFFFF"
                Background="#14FFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*"/>
                    <ColumnDefinition Width="1.38*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="20,0,0,20"
                        Background="#12000000"
                        Padding="38">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Empieza con UNUM"
                                   FontSize="33"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Crea tu cuenta y organiza tus finanzas desde hoy."
                                   Margin="0,10,0,0"
                                   Foreground="#DCE8FF"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>

                        <Border Margin="0,28,0,0"
                                CornerRadius="14"
                                Background="#17FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#24FFFFFF"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="✓ Objetivos para tus metas"
                                           Foreground="#E8F0FF"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="✓ Historial claro de ingresos y gastos"
                                           Foreground="#E8F0FF"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="✓ Exporta tus datos a CSV"
                                           Foreground="#E8F0FF"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        CornerRadius="0,20,20,0"
                        Background="#F8FAFF"
                        Padding="38">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="Crear cuenta"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#0E1A30"/>
                            <TextBlock Text="Solo te tomará un minuto."
                                       Margin="0,6,0,22"
                                       FontSize="13"
                                       Foreground="#5A6578"/>

                            <Border x:Name="brdMensajeRegistro"
                                    Background="#EAF6FF"
                                    BorderBrush="#B6DEFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,7"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtMensajeRegistro"
                                           Foreground="#1E4D6B"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Usuario"
                                       FontWeight="SemiBold"
                                       Foreground="#24324B"/>
                            <TextBox x:Name="txtUsuarioRegistro"
                                     Margin="0,7,0,4"
                                     Height="36"
                                     Padding="10,4"
                                     BorderBrush="#CCD6EA"
                                     BorderThickness="1"
                                     Background="White"
                                     TextChanged="txtUsuarioRegistro_TextChanged"/>
                            <TextBlock x:Name="txtUsuarioRegistroHint"
                                       Margin="0,0,0,12"
                                       Foreground="#B32137"
                                       FontSize="11"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="Contraseña"
                                       FontWeight="SemiBold"
                                       Foreground="#24324B"/>
                            <PasswordBox x:Name="txtPasswordRegistro"
                                         Margin="0,7,0,4"
                                         Height="36"
                                         Padding="10,4"
                                         BorderBrush="#CCD6EA"
                                         BorderThickness="1"
                                         Background="White"
                                         PasswordChanged="txtPasswordRegistro_PasswordChanged"/>
                            <TextBlock x:Name="txtPasswordRegistroHint"
                                       Margin="0,0,0,8"
                                       Foreground="#B32137"
                                       FontSize="11"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="Confirmar contraseña"
                                       FontWeight="SemiBold"
                                       Foreground="#24324B"/>
                            <PasswordBox x:Name="txtPasswordConfirmacion"
                                         Margin="0,7,0,4"
                                         Height="36"
                                         Padding="10,4"
                                         BorderBrush="#CCD6EA"
                                         BorderThickness="1"
                                         Background="White"
                                         PasswordChanged="txtPasswordConfirmacion_PasswordChanged"/>
                            <TextBlock x:Name="txtPasswordConfirmacionHint"
                                       Margin="0,0,0,12"
                                       Foreground="#B32137"
                                       FontSize="11"
                                       Visibility="Collapsed"/>

                            <Border Background="#EEF2FF"
                                    BorderBrush="#D8E1FF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,14">
                                <TextBlock Text="La contraseña debe tener al menos 8 caracteres, 1 mayúscula, 1 minúscula y 1 número."
                                           Foreground="#49566F"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="btnRegistrar"
                                    Content="Crear cuenta"
                                    Height="40"
                                    Click="btnRegistrar_Click"
                                    Background="#2B8A3E"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button x:Name="btnVolver"
                                    Content="Volver al inicio"
                                    Height="34"
                                    Margin="0,12,0,0"
                                    Click="btnVolver_Click"
                                    Background="Transparent"
                                    Foreground="#1C5DFF"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
