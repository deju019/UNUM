<Window x:Class="UNUM.ObjetivosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUM - Objetivos"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="txtTituloObjetivos"
                   Text="Objetivos de ahorro"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#FFF0F0F0"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="Nombre" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtNombreObjetivo" Margin="0,5,10,0" Height="26"/>

                <TextBlock Grid.Column="1" Text="Coste total" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCosteTotal" Margin="0,5,10,0" Height="26"/>

                <TextBlock Grid.Column="2" Text="Prioridad" FontWeight="Bold"/>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cmbPrioridad" Margin="0,5,10,0" Height="26">
                    <ComboBoxItem Content="1 - Alta" IsSelected="True"/>
                    <ComboBoxItem Content="2 - Media"/>
                    <ComboBoxItem Content="3 - Baja"/>
                </ComboBox>

                <Button Grid.Row="1"
                        Grid.Column="3"
                        x:Name="btnAgregarObjetivo"
                        Content="Agregar"
                        Width="90"
                        Height="26"
                        Margin="0,5,0,0"
                        Click="btnAgregarObjetivo_Click"
                        Background="#FF28A745"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="gridObjetivos"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Background="White"
                  AlternatingRowBackground="#FFF9F9F9"
                  SelectionMode="Single"
                  Margin="0,0,0,15"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Ahorro actual" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="txtNuevoAhorro" Width="120" Height="26" Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    x:Name="btnActualizarAhorro"
                    Content="Actualizar ahorro"
                    Width="140"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="btnActualizarAhorro_Click"
                    Background="#FF17A2B8"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button Grid.Column="4"
                    x:Name="btnEliminarObjetivo"
                    Content="Eliminar objetivo"
                    Width="140"
                    Height="30"
                    Click="btnEliminarObjetivo_Click"
                    Background="#FFDC3545"
                    Foreground="White"
                    FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
