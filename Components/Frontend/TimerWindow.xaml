<Window x:Class="UNUM.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo Ensayo - Pecha Kucha" Height="250" Width="300" Topmost="True" Background="#222222" WindowStartupLocation="CenterScreen">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="txtTiempo" Text="20" FontSize="80" FontWeight="Bold" Foreground="#FF28A745" HorizontalAlignment="Center"/>
        
        <TextBlock x:Name="txtSlide" Text="Diapositiva: 1 / 20" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnIniciar" Content="▶ Iniciar" Width="80" Height="30" Margin="5" Click="btnIniciar_Click" Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnPausar" Content="⏸ Pausar" Width="80" Height="30" Margin="5" Click="btnPausar_Click" Background="#FFDC3545" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </StackPanel>
</Window>