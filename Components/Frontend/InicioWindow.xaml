<Window x:Class="UNUM.InicioWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Title="UNUM - Bienvenido"
                Height="560"
                Width="920"
                MinHeight="520"
                MinWidth="820"
                WindowStartupLocation="CenterScreen"
                Background="#0B1220">
        <Grid>
                <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B1220" Offset="0"/>
                                <GradientStop Color="#13203A" Offset="0.5"/>
                                <GradientStop Color="#1B2E56" Offset="1"/>
                        </LinearGradientBrush>
                </Grid.Background>

                <Border Margin="26"
                                CornerRadius="20"
                                BorderThickness="1"
                                BorderBrush="#1FFFFFFF"
                                Background="#14FFFFFF">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                                CornerRadius="20,0,0,20"
                                                Background="#12000000"
                                                Padding="38">
                                        <StackPanel VerticalAlignment="Center">
                                                <Grid x:Name="logoContainer" Height="150" Width="150" Margin="0,0,0,18" HorizontalAlignment="Left" Opacity="0">
                                                        <Grid.RenderTransform>
                                                                <TranslateTransform Y="14"/>
                                                        </Grid.RenderTransform>
                                                        <Ellipse Fill="#1EFFFFFF"/>
                                                        <Border CornerRadius="75" Background="Transparent" Padding="14">
                                                                <Image x:Name="imgInicioLogo"
                                                                           Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           UseLayoutRounding="True"
                                                                           SnapsToDevicePixels="True"/>
                                                        </Border>
                                                </Grid>
                                                <TextBlock Text="Tu control financiero en un solo lugar."
                                                                   Margin="0,0,0,0"
                                                                   Foreground="#DDE8FF"
                                                                   FontSize="16"
                                                                   TextWrapping="Wrap"/>

                                                <Border Margin="0,26,0,0"
                                                                CornerRadius="14"
                                                                Background="#17FFFFFF"
                                                                BorderThickness="1"
                                                                BorderBrush="#24FFFFFF"
                                                                Padding="16">
                                                        <StackPanel>
                                                                <TextBlock Text="• Gestiona ingresos y gastos"
                                                                                   Foreground="#E8F0FF"
                                                                                   FontSize="13"
                                                                                   Margin="0,0,0,8"/>
                                                                <TextBlock Text="• Crea objetivos y presupuestos"
                                                                                   Foreground="#E8F0FF"
                                                                                   FontSize="13"
                                                                                   Margin="0,0,0,8"/>
                                                                <TextBlock Text="• Exporta a CSV y analiza tu progreso"
                                                                                   Foreground="#E8F0FF"
                                                                                   FontSize="13"/>
                                                        </StackPanel>
                                                </Border>
                                        </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                                CornerRadius="0,20,20,0"
                                                Background="#F8FAFF"
                                                Padding="40">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="390">
                                                <TextBlock Text="¡Bienvenido!"
                                                                   FontSize="30"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0E1A30"/>
                                                <TextBlock Text="Elige cómo quieres continuar."
                                                                   Margin="0,6,0,24"
                                                                   FontSize="13"
                                                                   Foreground="#5A6578"/>

                                                <Button x:Name="btnIrLogin"
                                                                Content="Iniciar sesión"
                                                                Height="42"
                                                                Margin="0,0,0,12"
                                                                Click="btnIrLogin_Click"
                                                                Background="#1C5DFF"
                                                                Foreground="White"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                BorderThickness="0"
                                                                Cursor="Hand"/>

                                                <Button x:Name="btnIrRegistro"
                                                                Content="Crear una cuenta"
                                                                Height="42"
                                                                Click="btnIrRegistro_Click"
                                                                Background="#2B8A3E"
                                                                Foreground="White"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                BorderThickness="0"
                                                                Cursor="Hand"/>
                                        </StackPanel>
                                </Border>
                        </Grid>
                </Border>
        </Grid>
</Window>
