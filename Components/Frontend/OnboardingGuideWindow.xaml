<Window x:Class="UNUM.OnboardingGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asistente de UNUM"
        Height="240"
        Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Background="#FFFFFF"
            BorderBrush="#2C2C2C"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header con paso y decoración dorada -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="20" Background="#D4AF37" CornerRadius="3" Margin="0,0,8,0"/>
                    <TextBlock Text="Paso " FontSize="13" FontWeight="SemiBold" Foreground="#2C2C2C"/>
                    <TextBlock x:Name="txtPaso" Text="1/9" FontSize="13" FontWeight="Bold" Foreground="#D4AF37"/>
                </StackPanel>
            </Grid>

            <!-- Contenido del paso -->
            <TextBlock Grid.Row="1"
                       x:Name="txtGuiaTexto"
                       Text="Bienvenido al tutorial interactivo."
                       FontSize="12"
                       Foreground="#3A3A3A"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       VerticalAlignment="Top"/>

            <!-- Botones -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="btnSaltar"
                        Content="Saltar"
                        Width="80"
                        Height="32"
                        Background="#F5F5F5"
                        Foreground="#666666"
                        FontSize="12"
                        FontWeight="Medium"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Click="btnSaltar_Click"
                        Margin="0,0,10,0"
                        Cursor="Hand"/>

                <Button x:Name="btnSiguiente"
                        Content="Siguiente →"
                        Width="110"
                        Height="32"
                        Background="#2C2C2C"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="btnSiguiente_Click"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
