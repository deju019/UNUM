<Window x:Class="UNUM.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido a UNUM"
        Height="520"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="NoResize">
    <Border Background="White"
            BorderBrush="#FFE3E7EB"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="30,30,30,20">
                <TextBlock Text="📱 Bienvenido a UNUM"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Tu gestor financiero personal"
                           FontSize="14"
                           Foreground="#5A6270"
                           Margin="0,0,0,25"/>

                <Border Background="#F7F9FB" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="✓ Registra tus transacciones" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock Text="Ingresos y gastos clasificados por categoría con notas personalizadas." FontSize="12" Foreground="#7A8A99" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#F7F9FB" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🔍 Filtra y busca" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock Text="Por tipo, categoría, fechas e importes. Ve exactamente lo que necesitas." FontSize="12" Foreground="#7A8A99" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#F7F9FB" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🎯 Establece objetivos" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock Text="Crea metas de ahorro y monitorea tu progreso hacia ellas." FontSize="12" Foreground="#7A8A99" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#F7F9FB" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="💡 Consejo: Usa los tooltips" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock Text="Pasa el ratón sobre los filtros y botones para ver ayuda contextual en cualquier momento." FontSize="12" Foreground="#7A8A99" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="#FFF7F9FB" BorderBrush="#FFE3E7EB" BorderThickness="1,1,1,0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkMostrarAlInicio" Grid.Column="0" Content="No volver a mostrar" VerticalAlignment="Center" Foreground="#5A6270" FontSize="12"/>
                    <Button x:Name="btnContinuar" Grid.Column="1" Content="Empezar →" Width="120" Height="35" Background="#FF2E86C1" Foreground="White" FontWeight="Bold" Click="btnContinuar_Click" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
