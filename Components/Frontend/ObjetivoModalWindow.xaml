<Window x:Class="UNUM.ObjetivoModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir/Editar Objetivo"
        Height="350"
        Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Nombre del Objetivo:"/>
            <TextBox x:Name="txtNombre"
                    Margin="0,5,0,15"
                    Height="25"/>

            <TextBlock Text="Coste Total (€):"/>
            <TextBox x:Name="txtCoste"
                    Margin="0,5,0,15"
                    Height="25"/>

            <TextBlock Text="Ahorro Actual (€):"/>
            <TextBox x:Name="txtAhorro"
                    Text="0"
                    Margin="0,5,0,15"
                    Height="25"/>

            <TextBlock Text="Prioridad:"/>
            <ComboBox x:Name="cmbPrioridad"
                    Margin="0,5,0,25"
                    Height="25">
                <ComboBoxItem Content="1 - Alta"
                        Tag="1"/>
                <ComboBoxItem Content="2 - Media"
                        Tag="2"
                        IsSelected="True"/>
                <ComboBoxItem Content="3 - Baja"
                        Tag="3"/>
            </ComboBox>

            <Button x:Name="btnGuardar"
                    Content="Guardar Objetivo"
                    Height="35"
                    Background="#FF0078D7"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="btnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>