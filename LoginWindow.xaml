<Window x:Class="UNUM.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUM - Iniciar Sesión" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Bienvenido a UNUM" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Usuario:"/>
            <TextBox x:Name="txtUsuarioLogin" Margin="0,5,0,15" Height="25"/>
            
            <TextBlock Text="Contraseña:"/>
            <PasswordBox x:Name="txtPasswordLogin" Margin="0,5,0,20" Height="25"/>
            
            <Button x:Name="btnLogin" Content="Iniciar Sesión" Height="30" Click="btnLogin_Click" Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>