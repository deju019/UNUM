<Window x:Class="UNUM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UNUM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="txtUsuario" HorizontalAlignment="Left" Margin="102,58,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="102,97,0,0" VerticalAlignment="Top" Width="120"/>
        <Button Content="Registrar" HorizontalAlignment="Left" Margin="102,149,0,0" VerticalAlignment="Top" Height="23" Width="60" Click="Button_Click_1"/>
    </Grid>
</Window>
